# Образец боевого backend/.env
#
# bootstrap_ubuntu24.sh создаёт этот файл сам и сам генерирует пароль
# базы, SECRET_KEY и TELEGRAM_WEBHOOK_SECRET. Образец нужен, только если
# .env пришлось собирать руками — например, роль в PostgreSQL уже
# существовала и её пароль скрипту неизвестен.
#
# Файл в git не попадает и не должен: в нём ключи.

# --- База. Пароль: openssl rand -hex 24
DATABASE_URL=postgresql://movex:ПАРОЛЬ@localhost:5432/movex_go

# --- Подпись токенов. Смена разлогинит всех: openssl rand -hex 32
SECRET_KEY=

# --- Режим. При APP_ENV=production приложение НЕ ЗАПУСТИТСЯ, если
#     CORS_ORIGINS=* — это защита от открытого наружу API.
APP_ENV=production
DEBUG=false
# Админка живёт на том же домене, по пути /panel/, поэтому отдельного
# имени здесь нет. При ADMIN_MODE=subdomain допишите admin.ДОМЕН в оба списка.
ALLOWED_HOSTS=ДОМЕН,127.0.0.1,localhost
CORS_ORIGINS=https://ДОМЕН

# --- SMS. Запасной путь: код уходит сюда, если Telegram не дошёл.
ESKIZ_EMAIL=
ESKIZ_PASSWORD=
# true отдаёт код прямо в ответе — в проде НИКОГДА
OTP_TEST_MODE=false

# --- Telegram: основной способ входа
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
# В проде опрос выключен: uvicorn работает в двух процессах, и каждый
# опрашивал бы бота отдельно — Telegram отвечает на это 409.
TELEGRAM_POLLING=false
# Пусто = /auth/telegram/webhook отдаёт 404. Заполнить: openssl rand -hex 32
TELEGRAM_WEBHOOK_SECRET=

# --- Приём платежей. Боевых ключей пока нет, см. docs/backend/PAYMENTS.md
CLICK_MERCHANT_ID=
CLICK_SERVICE_ID=
CLICK_SECRET_KEY=
CLICK_MERCHANT_USER_ID=
PAYME_MERCHANT_ID=
PAYME_KEY=
PAYME_ACCOUNT_FIELD=transaction_id
SPLIT_MODE=escrow

# --- Push. Без этих двух push_service молчит и ничего не ломает.
FCM_PROJECT_ID=
FCM_CREDENTIALS_FILE=
