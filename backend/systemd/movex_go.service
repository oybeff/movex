[Unit]
Description=Movex GO FastAPI Application
Documentation=https://github.com/your-username/movex_go
After=network.target postgresql.service

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/opt/movex_go
Environment="PATH=/opt/movex_go/venv/bin"
EnvironmentFile=/opt/movex_go/.env
ExecStart=/opt/movex_go/venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8000 --workers 4
Restart=always
RestartSec=10

# Security settings
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/movex_go/uploads /opt/movex_go/logs /opt/movex_go/backups

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=movex_go

[Install]
WantedBy=multi-user.target

