# ==============================
# DATABASE CONFIGURATION
# ==============================
# PostgreSQL connection string
# Format: postgresql://username:password@host:port/database_name
DATABASE_URL=postgresql://postgres:changeme@localhost:5432/movex_go

# PostgreSQL credentials (for Docker Compose)
POSTGRES_DB=movex_go
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changeme

# ==============================
# JWT AUTHENTICATION
# ==============================
# Secret key for JWT token generation (CHANGE THIS IN PRODUCTION!)
# Generate with: openssl rand -hex 32
SECRET_KEY=your_super_secret_key_change_this_in_production

# JWT algorithm
ALGORITHM=HS256

# Access token expiration time in minutes
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ==============================
# APPLICATION SETTINGS
# ==============================
# Application environment: development, staging, production
APP_ENV=development

# Application name
APP_NAME=Movex GO API

# Application version
APP_VERSION=1.0.0

# Debug mode (set to false in production)
DEBUG=true

# Allowed hosts (comma-separated)
ALLOWED_HOSTS=localhost,127.0.0.1

# ==============================
# CORS SETTINGS
# ==============================
# Allowed origins for CORS (comma-separated)
# Use * for all origins in development, specify domains in production
CORS_ORIGINS=http://localhost:3000,http://localhost:8080

# ==============================
# REDIS CONFIGURATION (Optional)
# ==============================
# Redis connection string for caching and rate limiting
REDIS_URL=redis://localhost:6379/0
REDIS_PASSWORD=

# ==============================
# FILE UPLOAD SETTINGS
# ==============================
# Maximum file upload size in MB
MAX_UPLOAD_SIZE_MB=10

# Upload directory
UPLOAD_DIR=./uploads

# Allowed file extensions (comma-separated)
ALLOWED_EXTENSIONS=jpg,jpeg,png,gif,pdf

# ==============================
# EMAIL SETTINGS (Optional)
# ==============================
# SMTP server configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=noreply@movexgo.com

# ==============================
# PAYMENT GATEWAY SETTINGS (Optional)
# ==============================
# Payme credentials
PAYME_MERCHANT_ID=
PAYME_SECRET_KEY=

# Click credentials
CLICK_MERCHANT_ID=your_click_merchant_id
CLICK_SERVICE_ID=your_click_service_id
CLICK_SECRET_KEY=your_click_secret_key
CLICK_MERCHANT_USER_ID=your_click_merchant_user_id
CLICK_RETURN_URL=movexgo://payment/success

# ==============================
# TELEGRAM NOTIFICATION
# ==============================
# Telegram bot token (BotFather'dan oling)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token

# Telegram guruh ID (guruhga bot qo'shing va ID oling)
TELEGRAM_GROUP_ID=your_telegram_group_id

# Telegram guruh topic ID (agar supergroup bo'lsa)
TELEGRAM_GROUP_TOPIC_ID=

# ==============================
# LOGGING
# ==============================
# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Log file path
LOG_FILE=./logs/app.log

# ==============================
# RATE LIMITING
# ==============================
# Rate limit per minute for API endpoints
RATE_LIMIT_PER_MINUTE=60

# Rate limit per minute for auth endpoints
AUTH_RATE_LIMIT_PER_MINUTE=5

# ==============================
# MONITORING (Optional)
# ==============================
# Sentry DSN for error tracking
SENTRY_DSN=

# ==============================
# BACKUP SETTINGS
# ==============================
# Backup directory
BACKUP_DIR=./backups

# Backup retention days
BACKUP_RETENTION_DAYS=30

